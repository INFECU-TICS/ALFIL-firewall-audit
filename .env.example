# ============================================================
# Alfil - Environment Variable Reference
# ============================================================
# Copy this file to .env for local development ONLY.
# In production (Dokploy), configure these in the Dokploy UI.
# NEVER commit a .env file with real secrets.
# ============================================================

# --- Application ---
DEBUG=false

# --- Database ---
# Local dev (relative path):
DATABASE_URL=sqlite:///./alfil.db
# Docker (absolute path inside container, mounted as named volume):
# DATABASE_URL=sqlite:////data/alfil.db

# --- Encryption ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# WARNING: Changing this key makes all stored encrypted passwords unreadable.
ENCRYPTION_KEY=change-me-generate-a-real-secret

# --- CORS ---
# JSON-encoded list of allowed frontend origins.
# Local dev:
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# Production example:
# CORS_ORIGINS=["https://alfil.yourdomain.com"]

# --- Traefik / Dokploy ---
# Public hostname where this app will be served.
DOMAIN=alfil.yourdomain.com

# API XML de Sophos: timeout por consulta (s) y consultas simultáneas durante la auditoría.
# Equipos lentos (p. ej. v23 de laboratorio) necesitan timeout alto y pocos hilos.
SOPHOS_REQUEST_TIMEOUT=90
SOPHOS_COLLECT_WORKERS=4
